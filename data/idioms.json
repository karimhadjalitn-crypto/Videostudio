[{"fusha":"السَّلَامُ عَلَيْكُمْ.","spoken":"السَّلَام عَلَيْكُم.","de":"Friede sei mit euch."},{"fusha":"وَعَلَيْكُمُ السَّلَامُ.","spoken":"وَعَلَيْكُم السَّلَام.","de":"Und mit euch sei Frieden."},{"fusha":"أَهْلًا وَسَهْلًا.","spoken":"أَهْلًا وَسَهْلًا.","de":"Herzlich willkommen."},{"fusha":"مَرْحَبًا.","spoken":"مَرْحَبًا.","de":"Hallo."},{"fusha":"كَيْفَ حَالُكَ؟","spoken":"كَيْفَ حَالَك؟","de":"Wie geht es dir?"},{"fusha":"أَنَا بِخَيْرٍ، وَالْحَمْدُ لِلَّهِ.","spoken":"أَنَا بِخَيْر، وَالْحَمْدُ لِلَّه.","de":"Mir geht es gut, al-ḥamdu li-llāh."},{"fusha":"شُكْرًا جَزِيلًا.","spoken":"شُكْرًا جَزِيلًا.","de":"Vielen Dank."},{"fusha":"عَفْوًا.","spoken":"عَفْوًا.","de":"Gern geschehen/Entschuldigung."},{"fusha":"مِنْ فَضْلِكَ.","spoken":"مِنْ فَضْلِك.","de":"Bitte (zu einem Mann)."},{"fusha":"مِنْ فَضْلِكِ.","spoken":"مِنْ فَضْلِك.","de":"Bitte (zu einer Frau)."},{"fusha":"آسِفٌ.","spoken":"آسِف.","de":"Es tut mir leid (m.)."},{"fusha":"لَا بَأْسَ.","spoken":"لَا بَأْس.","de":"Kein Problem/Es macht nichts."},{"fusha":"إِلَى اللِّقَاءِ.","spoken":"إِلَى اللِّقَاء.","de":"Auf Wiedersehen."},{"fusha":"فِي أَمَانِ اللَّهِ.","spoken":"فِي أَمَان اللَّه.","de":"In Allahs Schutz."},{"fusha":"بَارَكَ اللَّهُ فِيكَ.","spoken":"بَارَكَ اللَّه فِيك.","de":"Möge Allah dich segnen."},{"fusha":"تَقَبَّلَ اللَّهُ مِنَّا وَمِنْكُمْ.","spoken":"تَقَبَّلَ اللَّه مِنَّا وَمِنْكُم.","de":"Möge Allah von uns und euch annehmen."},{"fusha":"الْحَمْدُ لِلَّهِ.","spoken":"الْحَمْدُ لِلَّه.","de":"Alles Lob gebührt Allah."},{"fusha":"سُبْحَانَ اللَّهِ.","spoken":"سُبْحَانَ اللَّه.","de":"Gepriesen sei Allah."},{"fusha":"اللَّهُ أَكْبَرُ.","spoken":"اللَّه أَكْبَر.","de":"Allah ist größer/am größten."},{"fusha":"أَسْتَغْفِرُ اللَّهَ.","spoken":"أَسْتَغْفِر اللَّه.","de":"Ich bitte Allah um Vergebung."}]